#: D:/TTMediaBot-master/bot/__init__.py:139
msgid "Update completed successfully! I am back online."
msgstr "A frissítés sikeresen befejeződött! Újra online vagyok."

#: D:/TTMediaBot-master/bot/__init__.py:175
msgid ""
"The bot is starting an update process and will restart shortly. It may go"
" offline at any moment."
msgstr ""
"A bot frissítési folyamatot indít, és hamarosan újraindul. Bármelyik "
"pillanatban offline állapotba kerülhet."

