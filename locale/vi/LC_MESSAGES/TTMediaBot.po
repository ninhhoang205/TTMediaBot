"{available_languages}"

#: D:/TTMediaBot/bot/commands/admin_commands.py:107
msgid "NICKNAME Changes bot's nickname"
msgstr "BIỆT_DANH Đổi biệt danh của bot"

#: D:/TTMediaBot/bot/commands/admin_commands.py:118
msgid ""
"r/f Clears bot's cache. r clears recents, f clears favorites, without an "
"option clears the entire cache"
msgstr ""
"r/f Xóa dữ liệu lưu tạm của bot. r xóa danh sách nghe gần đây, f xóa danh sách "
"yêu thích. Nếu không ghi gì, sẽ xóa toàn bộ"

#: D:/TTMediaBot/bot/commands/admin_commands.py:126
msgid "Cache cleared"
msgstr "Đã xóa dữ liệu lưu tạm"

#: D:/TTMediaBot/bot/commands/admin_commands.py:130
msgid "Recents cleared"
msgstr "Đã xóa danh sách nghe gần đây"

#: D:/TTMediaBot/bot/commands/admin_commands.py:134
msgid "Favorites cleared"
msgstr "Đã xóa danh sách yêu thích"

#: D:/TTMediaBot/bot/commands/admin_commands.py:141
msgid ""
"Join channel. first argument is channel name or id, second argument is "
"password, split argument \" | \", if password is undefined, don't type second "
"argument"
msgstr ""
"Vào một kênh. Phần đầu là tên hoặc ID của kênh, phần sau là mật khẩu. Hai phần "
"cách nhau bằng dấu \" | \". Nếu kênh không có mật khẩu thì không cần ghi phần "
"sau"

#: D:/TTMediaBot/bot/commands/admin_commands.py:160
msgid "This channel does not exist"
msgstr "Kênh này không tồn tại"

#: D:/TTMediaBot/bot/commands/admin_commands.py:174
#, python-brace-format
msgid "Error joining channel: {error}"
msgstr "Lỗi khi vào kênh: {error}"

#: D:/TTMediaBot/bot/commands/admin_commands.py:222
msgid "Enables or disables voice transmission"
msgstr "Bật hoặc tắt việc truyền âm thanh"

#: D:/TTMediaBot/bot/commands/admin_commands.py:229
#: D:/TTMediaBot/bot/commands/admin_commands.py:231
msgid "Voice transmission enabled"
msgstr "Đã bật truyền âm thanh"

#: D:/TTMediaBot/bot/commands/admin_commands.py:236
msgid "Voice transmission disabled"
msgstr "Đã tắt truyền âm thanh"

#: D:/TTMediaBot/bot/commands/admin_commands.py:242
msgid "Locks or unlocks the bot"
msgstr "Khóa hoặc mở khóa bot"

