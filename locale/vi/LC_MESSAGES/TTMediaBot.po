msgid "Locked"
msgstr "Đã khóa"

#: D:/TTMediaBot/bot/commands/admin_commands.py:249
msgid "Unlocked"
msgstr "Đã mở khóa"

#: D:/TTMediaBot/bot/commands/admin_commands.py:256
msgid "STATUS Changes bot's status"
msgstr "TRẠNG_THÁI Đổi trạng thái của bot"

#: D:/TTMediaBot/bot/commands/admin_commands.py:266
msgid "Enables or disables event handling"
msgstr "Bật hoặc tắt việc xử lý sự kiện"

#: D:/TTMediaBot/bot/commands/admin_commands.py:273
msgid "Event handling is enabled"
msgstr "Đã bật xử lý sự kiện"

#: D:/TTMediaBot/bot/commands/admin_commands.py:275
msgid "Event handling is disabled"
msgstr "Đã tắt xử lý sự kiện"

#: D:/TTMediaBot/bot/commands/admin_commands.py:283
msgid ""
"Toggles channel messages. When disabled, notifications are sent privately "
"instead of public channel"
msgstr ""
"Bật hoặc tắt tin nhắn công khai trong kênh. Khi tắt, bot sẽ gửi thông báo "
"riêng cho người dùng thay vì gửi vào kênh"

#: D:/TTMediaBot/bot/commands/admin_commands.py:293
msgid "Public channel messages enabled (bot will announce in channel)."
msgstr "Đã bật tin nhắn công khai (bot sẽ thông báo trong kênh)."

#: D:/TTMediaBot/bot/commands/admin_commands.py:297
msgid ""
"Private messages mode enabled (bot will send notifications privately instead "
"of public channel)."
msgstr ""
"Đã bật chế độ tin nhắn riêng (bot sẽ gửi thông báo riêng thay vì gửi vào kênh)."

#: D:/TTMediaBot/bot/commands/admin_commands.py:304
msgid "Saves bot's configuration"
msgstr "Lưu cấu hình của bot"

#: D:/TTMediaBot/bot/commands/admin_commands.py:308
msgid "Configuration saved"
msgstr "Đã lưu cấu hình"

#: D:/TTMediaBot/bot/commands/admin_commands.py:315
msgid ""
"+/-USERNAME Manages a list of administrators. +USERNAME adds a user. -USERNAME "
"removes it. Without an option shows the list"
msgstr ""
"+/-TÊN_NGƯỜI_DÙNG Quản lý danh sách quản trị viên. +TÊN thêm một người. -TÊN "
"xóa người đó. Nếu không ghi gì, sẽ hiện danh sách"

#: D:/TTMediaBot/bot/commands/admin_commands.py:331
msgid "This user is not in the admin list"
msgstr "Người dùng này không có trong danh sách quản trị viên"

#: D:/TTMediaBot/bot/commands/admin_commands.py:337
#: D:/TTMediaBot/bot/commands/admin_commands.py:367
msgid "<Anonymous>"
msgstr "<Ẩn danh>"

#: D:/TTMediaBot/bot/commands/admin_commands.py:347
msgid ""
"+/-USERNAME Manages a list of banned users. +USERNAME adds a user. -USERNAME "
"removes it. Without an option shows the list"
msgstr ""
"+/-TÊN_NGƯỜI_DÙNG Quản lý danh sách người bị cấm. +TÊN thêm một người. -TÊN gỡ "
"cấm người đó. Nếu không ghi gì, sẽ hiện danh sách"

#: D:/TTMediaBot/bot/commands/admin_commands.py:362
