#: D:/TTMediaBot/bot/__init__.py:139
msgid "Update completed successfully! I am back online."
msgstr "Pembaruan berhasil diselesaikan! Saya kembali online."

#: D:/TTMediaBot/bot/__init__.py:175
msgid ""
"The bot is starting an update process and will restart shortly. It may go"
" offline at any moment."
msgstr ""
"Bot sedang memulai proses pembaruan dan akan segera dimulai ulang. Bot "
"dapat offline kapan saja."

